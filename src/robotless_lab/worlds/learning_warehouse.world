<?xml version="1.0"?>
<!-- Original primitive geometry; no external meshes/textures. SPDX-License-Identifier: Apache-2.0 -->
<sdf version="1.6">
  <world name="robotless_warehouse">
    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.12 0.17 0.22 1</background></scene>
    <light name="warehouse_light" type="directional">
      <pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular><direction>-0.3 -0.4 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry>
          <material><ambient>0.42 0.46 0.50 1</ambient><diffuse>0.42 0.46 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="north_wall">
      <static>true</static><pose>0 5 0.6 0 0 0</pose><link name="wall">
        <collision name="collision"><geometry><box><size>12 0.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.15 1.2</size></box></geometry><material><ambient>0.7 0.75 0.8 1</ambient><diffuse>0.7 0.75 0.8 1</diffuse></material></visual>
      </link>
    </model>
