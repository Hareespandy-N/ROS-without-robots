      </link>
    </model>
    <model name="shelf_a">
      <static>true</static><pose>-2 0 0.45 0 0 0</pose><link name="shelf">
        <collision name="collision"><geometry><box><size>1.2 1.6 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 1.6 0.9</size></box></geometry><material><ambient>0.12 0.42 0.70 1</ambient><diffuse>0.12 0.42 0.70 1</diffuse></material></visual>
      </link>
    </model>
